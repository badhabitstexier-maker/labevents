# Clé publique Web3Forms utilisée par le formulaire statique de /contact.
# Créez une clé sur Web3Forms, puis copiez ce fichier vers `.env` sans jamais
# versionner la vraie valeur.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# URL du Chat Trigger n8n de l'agent d'accueil (se termine par `/chat`).
# Sans valeur, le widget de chat n'est pas rendu. Ne jamais versionner la vraie
# URL : ce dépôt est public.
PUBLIC_N8N_CHAT_URL=
