---
/**
 * Métadonnées de <head> : SEO de base, Open Graph, canonique.
 * Toute page peut surcharger le titre, la description et l'image.
 */
import { site } from '@data/site';
import { seoDefauts, construireTitre } from '@data/seo';

interface Props {
  titre?: string;
  /**
   * Titre `<title>` complet, utilisé TEL QUEL.
   * Pour les pages dont l'intitulé est arrêté mot pour mot et ne doit pas
   * recevoir le suffixe « — LabEvents » (l'accueil, notamment).
   * Prioritaire sur `titre`.
   */
  titreComplet?: string;
  description?: string;
  /** Chemin absolu depuis la racine du site (ex. /images/og.jpg). */
  image?: string | null;
  /** Exclut la page de l'indexation (pages techniques, temporaires). */
  noindex?: boolean;
}

const {
  titre,
  titreComplet: titreImpose,
  description = seoDefauts.descriptionParDefaut,
  image = seoDefauts.imageParDefaut,
  noindex = false,
} = Astro.props;

const titreComplet = titreImpose ?? construireTitre(titre);
const cheminCanonique = Astro.url.pathname === '/'
  ? '/'
  : Astro.url.pathname.replace(/\/$/, '');
const canonique = new URL(cheminCanonique, Astro.site ?? site.url);
const imageAbsolue = image ? new URL(image, Astro.site ?? site.url).href : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titreComplet}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#0F1B2D" />
<link rel="canonical" href={canonique.href} />
<link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={titreComplet} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonique.href} />
{imageAbsolue && (
  <>
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LabEvents — Événementiel et sites internet en Nouvelle-Calédonie" />
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titreComplet} />
<meta name="twitter:description" content={description} />
{imageAbsolue && <meta name="twitter:image" content={imageAbsolue} />}
{imageAbsolue && <meta name="twitter:image:alt" content="LabEvents — Événementiel et sites internet en Nouvelle-Calédonie" />}

<meta name="generator" content={Astro.generator} />
