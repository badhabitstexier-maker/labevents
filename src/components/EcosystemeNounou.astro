---
/**
 * Écosystème nounou.nc.
 *
 * ⚠️ RÈGLES DE FORMULATION (CLAUDE.md § F) ⚠️
 *   - formulation AUTORISÉE : « un écosystème de cinq sites » ;
 *   - formulation INTERDITE : « cinq domaines » ;
 *   - ne PAS préciser davantage la nature de `services.nounou.nc`.
 */
import { ecosystemeNounou, realisationParId } from '@data/realisations';
import { etudeDeCas as trame } from '@data/messages';

interface Props {
  niveauTitre?: 'h2' | 'h3';
  surTitre?: string;
  /** Identifiant optionnel du titre pour `aria-labelledby` sur la page hôte. */
  idTitre?: string;
}

const {
  niveauTitre: Titre = 'h3',
  surTitre = 'Réalisation digitale',
  idTitre,
}: Props = Astro.props;

const realisation = realisationParId(ecosystemeNounou.id);
---

<article class="grid gap-8 lg:grid-cols-12 lg:gap-16">
  <div class="lg:col-span-4">
    <p class="text-2xs font-semibold text-ink-muted uppercase">{surTitre}</p>
    <Titre id={idTitre} class="mt-4 text-2xl break-words">{ecosystemeNounou.titre}</Titre>
  </div>

  <div class="lg:col-span-8">
    <p class="max-w-texte text-base text-ink">{realisation?.nature}</p>

    <ul class="mt-bloc divide-y divide-line border-y border-line">
      {
        ecosystemeNounou.sites.map((siteVertical) => (
          <li>
            <a
              href={siteVertical.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-h-16 flex-col justify-center gap-0.5 py-4 sm:flex-row sm:items-baseline sm:justify-start sm:gap-6 sm:py-5"
            >
              <span class="text-xs font-medium break-words text-ink-strong underline decoration-line decoration-1 underline-offset-4 transition-colors group-hover:decoration-gold-500 sm:w-64 sm:shrink-0">
                {siteVertical.label}
                <span class="sr-only"> — nouvelle fenêtre</span>
              </span>
              <span class="text-xs text-ink-muted">{siteVertical.activite}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      realisation?.url && (
        <p class="mt-8">
          <a
            href={realisation.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 text-xs font-medium text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4 transition-colors hover:text-navy-700"
          >
            {trame.lien}
            <span class="sr-only">— {ecosystemeNounou.titre}, nouvelle fenêtre</span>
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M9 7h8v8" />
            </svg>
          </a>
        </p>
      )
    }
  </div>
</article>
