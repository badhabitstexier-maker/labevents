---
/** Icônes linéaires internes utilisées uniquement par la page Contact. */
interface Props {
  nom: 'telephone' | 'email' | 'local' | 'expertises' | 'direct' | 'orientation' | 'informations';
  class?: string;
}

const { nom, class: classeSupplementaire = '' } = Astro.props;
---

<svg
  class={classeSupplementaire}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nom === 'telephone' && <path d="M7.2 3.8 9.7 7a1.5 1.5 0 0 1-.1 1.9L8.2 10.4a14.2 14.2 0 0 0 5.4 5.4l1.5-1.4a1.5 1.5 0 0 1 1.9-.1l3.2 2.5a1.5 1.5 0 0 1 .4 1.9l-.8 1.4a2.5 2.5 0 0 1-2.5 1.2C9.6 20.2 3.8 14.4 2.7 6.7a2.5 2.5 0 0 1 1.2-2.5l1.4-.8a1.5 1.5 0 0 1 1.9.4Z" />}
  {nom === 'email' && <><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m4 7 8 6 8-6" /></>}
  {nom === 'local' && <><path d="M20 10c0 5.5-8 11-8 11S4 15.5 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {nom === 'expertises' && <><rect x="2.5" y="4" width="8" height="16" rx="1.5" /><rect x="13.5" y="4" width="8" height="16" rx="1.5" /><path d="M6 8h1M17 8h1M6 12h1M17 12h1" /></>}
  {nom === 'direct' && <><path d="M20.5 15a3 3 0 0 1-3 3H9l-5.5 3v-3.8a3 3 0 0 1-1.5-2.6V7a3 3 0 0 1 3-3h12.5a3 3 0 0 1 3 3Z" /><path d="M6.5 9h11M6.5 13h7" /></>}
  {nom === 'orientation' && <><path d="M4 6h10M4 12h16M4 18h10" /><path d="m16 3 3 3-3 3M12 15l3 3-3 3" /></>}
  {nom === 'informations' && <><path d="M12 2.5 20 6v5.5c0 4.6-3.2 8.2-8 10-4.8-1.8-8-5.4-8-10V6Z" /><path d="m8.5 12 2.2 2.2 4.8-5" /></>}
</svg>
