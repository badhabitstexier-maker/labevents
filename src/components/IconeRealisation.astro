---
/** Icônes linéaires dédiées à la page Réalisations, sans dépendance externe. */
export type NomIconeRealisation =
  | 'enfant'
  | 'livre'
  | 'patte'
  | 'maison'
  | 'mallette'
  | 'groupe'
  | 'cible'
  | 'ecran'
  | 'trophee'
  | 'localisation'
  | 'validation'
  | 'message';

interface Props {
  nom: NomIconeRealisation;
  class?: string;
}

const { nom, class: classeSupplementaire = '' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['size-7 shrink-0', classeSupplementaire]}
>
  {nom === 'enfant' && <><circle cx="12" cy="6" r="3"/><path d="M7 21v-4a5 5 0 0 1 10 0v4M8 11l-3 3m11-3 3 3M10 21v-4m4 4v-4"/></>}
  {nom === 'livre' && <><path d="M3 5.5A3.5 3.5 0 0 1 6.5 2H11v17H6.5A3.5 3.5 0 0 0 3 22z"/><path d="M21 5.5A3.5 3.5 0 0 0 17.5 2H13v17h4.5A3.5 3.5 0 0 1 21 22z"/></>}
  {nom === 'patte' && <><ellipse cx="12" cy="15.5" rx="5" ry="4"/><circle cx="6" cy="9" r="2"/><circle cx="10" cy="6" r="2"/><circle cx="14" cy="6" r="2"/><circle cx="18" cy="9" r="2"/></>}
  {nom === 'maison' && <><path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10M9 21v-7h6v7"/></>}
  {nom === 'mallette' && <><rect x="3" y="7" width="18" height="13" rx="1"/><path d="M9 7V4h6v3M3 12h18M10 12v2h4v-2"/></>}
  {nom === 'groupe' && <><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M14 15a5 5 0 0 1 7 4.5V21"/></>}
  {nom === 'cible' && <><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/><path d="m15 9 6-6m0 0v4m0-4h-4"/></>}
  {nom === 'ecran' && <><rect x="2" y="3" width="20" height="14" rx="1"/><path d="M8 21h8m-4-4v4"/></>}
  {nom === 'trophee' && <><path d="M8 4h8v4a4 4 0 0 1-8 0zM10 14v4m4-4v4M8 21h8"/><path d="M8 6H4v2a4 4 0 0 0 4 4m8-6h4v2a4 4 0 0 1-4 4"/></>}
  {nom === 'localisation' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></>}
  {nom === 'validation' && <><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></>}
  {nom === 'message' && <><path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8m-8 3h5"/></>}
</svg>
