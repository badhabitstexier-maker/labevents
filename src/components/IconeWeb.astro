---
/** Icônes linéaires du Lot 5C, sans dépendance ni contenu sémantique. */
export type NomIconeWeb =
  | 'horloge'
  | 'outil'
  | 'localisation'
  | 'ecrans'
  | 'contenus'
  | 'recherche'
  | 'performance'
  | 'marteau'
  | 'mallette'
  | 'boutique'
  | 'personne'
  | 'site'
  | 'interlocuteur';

interface Props {
  nom: NomIconeWeb;
  class?: string;
}

const { nom, class: classeSupplementaire = '' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['size-7 shrink-0 text-gold-500', classeSupplementaire]}
>
  {nom === 'horloge' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {nom === 'outil' && <><path d="M14.5 6.5a4 4 0 0 0-5-5l2.1 2.1-2.8 2.8-2.1-2.1a4 4 0 0 0 5 5L20 17.6 17.6 20l-8.3-8.3"/><path d="m5 14-3 3 5 5 3-3"/></>}
  {nom === 'localisation' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></>}
  {nom === 'ecrans' && <><rect x="2" y="4" width="14" height="11" rx="1"/><path d="M7 20h4m-2-5v5"/><rect x="17" y="8" width="5" height="10" rx="1"/></>}
  {nom === 'contenus' && <><path d="M6 2h9l4 4v16H6z"/><path d="M15 2v5h4M9 12h7M9 16h7M9 8h2"/></>}
  {nom === 'recherche' && <><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6M4 21c1.5-3 4-4.5 7-4.5"/></>}
  {nom === 'performance' && <><path d="M4 14a8 8 0 1 1 16 0"/><path d="m12 14 4-5M3 18h18"/></>}
  {nom === 'marteau' && <><path d="m14 5 5 5M12.5 6.5l2-2 5 5-2 2zM13 9 3 19l2 2 10-10"/><path d="m8 3 3-1 2 2-4 4-2-2z"/></>}
  {nom === 'mallette' && <><rect x="3" y="7" width="18" height="13" rx="1"/><path d="M9 7V4h6v3M3 12h18M10 12v2h4v-2"/></>}
  {nom === 'boutique' && <><path d="M4 10v11h16V10M3 10l2-6h14l2 6"/><path d="M3 10a3 3 0 0 0 5 2 3 3 0 0 0 4 0 3 3 0 0 0 4 0 3 3 0 0 0 5-2M8 21v-5h8v5"/></>}
  {nom === 'personne' && <><circle cx="12" cy="7" r="4"/><path d="M4 22a8 8 0 0 1 16 0"/></>}
  {nom === 'site' && <><rect x="2" y="4" width="20" height="14" rx="1"/><path d="M2 8h20M8 22h8M12 18v4"/></>}
  {nom === 'interlocuteur' && <><path d="M5 12a7 7 0 0 1 14 0v5a2 2 0 0 1-2 2h-2"/><path d="M5 13H3v4h3v-6M19 13h2v4h-3v-6"/><circle cx="12" cy="10" r="3"/></>}
</svg>
