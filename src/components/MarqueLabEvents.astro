---
/**
 * Bloc-marque LabEvents.
 *
 * Le logo fourni et validé est utilisé sans redessin ni interprétation.
 * L'asset conserve le dessin, les proportions, la typographie et les couleurs
 * de la source ; seules ses marges transparentes ont été retirées.
 */
import { site } from '@data/site';

interface Props {
  /** `sm` : header et pied de page. `md` : usages plus affirmés. */
  taille?: 'sm' | 'md';
  class?: string;
}

const {
  taille = 'sm',
  class: classeSupplementaire = '',
} = Astro.props;

const tailles = {
  sm: 'h-6 w-auto',
  md: 'h-8 w-auto',
} as const;
---

<img
  src="/brand/labevents-logo.png"
  alt={site.name}
  width="1294"
  height="173"
  decoding="async"
  class:list={[
    'block max-w-full',
    tailles[taille],
    classeSupplementaire,
  ]}
/>
