---
/**
 * Étude de cas Salon de l'Emploi pour la page Réalisations.
 *
 * Les informations détaillées restent strictement conditionnées par
 * `publiable`. Quand elles sont absentes, la composition réalloue leur place
 * au mockup validé au lieu de rendre des emplacements vides.
 */
import IconeRealisation, {
  type NomIconeRealisation,
} from '@components/IconeRealisation.astro';
import MockupAppareil from '@components/MockupAppareil.astro';
import { etudeDeCas as trame } from '@data/messages';
import {
  etudeDeCasAffichable,
  premiereCaptureAffichable,
  type Realisation,
} from '@data/realisations';

interface Props {
  realisation: Realisation;
  surTitre: string;
  niveauTitre?: 'h2' | 'h3';
  idTitre?: string;
}

const {
  realisation,
  surTitre,
  niveauTitre: Titre = 'h3',
  idTitre,
} = Astro.props;

const afficherEtudeDeCas = etudeDeCasAffichable(realisation);

const blocsBruts: Array<{
  intitule: string;
  texte: string | null;
  icone: NomIconeRealisation;
}> = [
  {
    intitule: trame.besoin,
    texte: realisation.etudeDeCas.besoin,
    icone: 'cible',
  },
  {
    intitule: trame.realise,
    texte: realisation.etudeDeCas.realise,
    icone: 'ecran',
  },
  {
    intitule: trame.resultat,
    texte: realisation.etudeDeCas.resultat,
    icone: 'trophee',
  },
];

const blocs: Array<{
  intitule: string;
  texte: string;
  icone: NomIconeRealisation;
}> = afficherEtudeDeCas
  ? blocsBruts.flatMap((bloc) =>
      bloc.texte === null ? [] : [{ ...bloc, texte: bloc.texte }],
    )
  : [];

const capture = premiereCaptureAffichable(realisation);
---

<article
  class:list={[
    'grid gap-8 md:grid-cols-12 md:items-center md:gap-0',
    blocs.length === 0 && 'lg:items-center',
  ]}
>
  <div class="md:col-span-12 md:mb-8 lg:col-span-3 lg:mb-0 lg:pr-8 xl:pr-10">
    <p class="text-2xs font-semibold tracking-wide text-gold-600 uppercase">
      {surTitre}
    </p>
    <Titre id={idTitre} class="mt-5 text-xl break-words">{realisation.titre}</Titre>
    <p class="mt-5 text-xs text-ink-muted">{realisation.nature}</p>

    {
      realisation.url && (
        <p class="mt-7">
          <a
            href={realisation.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 text-xs font-medium text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4 transition-colors hover:text-navy-700"
          >
            {trame.lien}
            <span class="sr-only">— {realisation.titre}, nouvelle fenêtre</span>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M9 7h8v8" />
            </svg>
          </a>
        </p>
      )
    }
  </div>

  {
    blocs.length > 0 && (
      <dl class="border-t border-line pt-5 md:col-span-6 md:border-t-0 md:border-l md:px-6 md:pt-0 lg:col-span-4 lg:px-8 xl:px-10">
        {blocs.map((bloc) => (
          <div class="flex gap-3 border-b border-line py-4 first:pt-0 last:border-b-0 last:pb-0">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-gold-100 text-gold-600">
              <IconeRealisation nom={bloc.icone} class="size-5" />
            </span>
            <div class="min-w-0 flex-1">
              <dt class="text-2xs font-semibold text-ink-strong uppercase">{bloc.intitule}</dt>
              <dd class="mt-1.5 text-xs text-ink-muted">{bloc.texte}</dd>
            </div>
          </div>
        ))}
      </dl>
    )
  }

  {
    capture && (
      <div
        class:list={[
          'flex items-center border-t border-line pt-8 md:col-span-6 md:border-t-0 md:border-l md:pt-0 md:pl-6',
          blocs.length > 0
            ? 'lg:col-span-5 lg:pl-8 xl:pl-10'
            : 'md:col-span-12 md:pl-0 lg:col-span-9 lg:border-l lg:pl-10 xl:pl-14',
        ]}
      >
        <MockupAppareil
          src={capture}
          alt="Le site salonemploi.nc présenté sur un ordinateur portable noir et un téléphone"
          largeur={1448}
          hauteur={1086}
          class="object-contain"
        />
      </div>
    )
  }
</article>
