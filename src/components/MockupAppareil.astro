---
/**
 * Cadres d'appareils construits en HTML/CSS autour d'une capture réelle.
 * Le composant ne recadre ni ne transforme le contenu de la capture.
 */
interface Props {
  variante: 'ordinateur' | 'telephone';
  src: string;
  alt: string;
  largeur: number;
  hauteur: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  variante,
  src,
  alt,
  largeur,
  hauteur,
  loading = 'lazy',
  fetchpriority,
  class: classeSupplementaire = '',
} = Astro.props;
---

{variante === 'ordinateur' ? (
  <div class:list={['relative', classeSupplementaire]}>
    <div class="rounded-lg border border-navy-700 bg-navy-900 p-2 shadow-media sm:p-3">
      <span class="mx-auto mb-2 block size-1.5 rounded-full bg-navy-600" aria-hidden="true"></span>
      <div class="overflow-hidden rounded-sm bg-paper">
        <img
          src={src}
          alt={alt}
          width={largeur}
          height={hauteur}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
    </div>
    <div class="mx-auto h-2 w-11/12 rounded-b-lg border-x border-b border-line-strong bg-paper-cool shadow-subtle" aria-hidden="true"></div>
    <div class="mx-auto h-1 w-1/3 rounded-b-full bg-line-strong" aria-hidden="true"></div>
  </div>
) : (
  <div class:list={['overflow-hidden rounded-xl border-4 border-navy-900 bg-navy-900 p-1 shadow-media', classeSupplementaire]}>
    <span class="mx-auto mb-1 block h-1.5 w-10 rounded-full bg-navy-700" aria-hidden="true"></span>
    <div class="overflow-hidden rounded-lg bg-paper">
      <img
        src={src}
        alt={alt}
        width={largeur}
        height={hauteur}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        class="block h-auto w-full"
      />
    </div>
    <span class="mx-auto mt-1 block size-1.5 rounded-full border border-navy-600" aria-hidden="true"></span>
  </div>
)}
