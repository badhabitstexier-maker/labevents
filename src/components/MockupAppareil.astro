---
/**
 * Affiche un mockup composite finalisé à partir d'un châssis fourni.
 * Le composant ne dessine, ne recadre et ne repositionne aucun appareil.
 */
interface Props {
  src: string;
  alt: string;
  largeur: number;
  hauteur: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  largeur,
  hauteur,
  loading = 'lazy',
  fetchpriority,
  sizes = '(min-width: 1024px) 50vw, 90vw',
  class: classeSupplementaire = '',
} = Astro.props;

const mockupsOptimises: Record<string, { src: string; srcset: string }> = {
  '/images/web/mockups/nounou-ecran-bureau-telephone.png': {
    src: '/images/optimized/mockups/nounou-ecran-bureau-telephone-1448.webp',
    srcset: '/images/optimized/mockups/nounou-ecran-bureau-telephone-724.webp 724w, /images/optimized/mockups/nounou-ecran-bureau-telephone-1448.webp 1448w',
  },
  '/images/web/mockups/salonemploi-portable-telephone.png': {
    src: '/images/optimized/mockups/salonemploi-portable-telephone-1448.webp',
    srcset: '/images/optimized/mockups/salonemploi-portable-telephone-724.webp 724w, /images/optimized/mockups/salonemploi-portable-telephone-1448.webp 1448w',
  },
};

const sourceOptimisee = mockupsOptimises[src];
---

<img
  src={sourceOptimisee?.src ?? src}
  srcset={sourceOptimisee?.srcset}
  sizes={sourceOptimisee ? sizes : undefined}
  alt={alt}
  width={largeur}
  height={hauteur}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class:list={['block h-auto w-full', classeSupplementaire]}
/>
