---
/**
 * Section de page.
 *
 * Centralise le rythme vertical et les marges latérales pour que chaque
 * section n'ait pas à réinventer ses valeurs :
 *   - respiration `--spacing-section` en mobile, `--spacing-section-lg`
 *     à partir de 1024 px ;
 *   - gouttière `--spacing-gutter` en mobile, plus large en desktop ;
 *   - largeur maximale `--container-page`.
 *
 * Le fond par défaut est le blanc : conformément à la direction graphique,
 * le blanc / très clair reste largement majoritaire. Les variantes `warm` et
 * `navy` sont des respirations ponctuelles, pas un rythme alterné.
 */
interface Props {
  fond?: 'paper' | 'warm' | 'navy';
  /** Balise de section. `section` par défaut. */
  as?: 'section' | 'div';
  /** Relie la section à son titre pour la navigation par landmarks. */
  'aria-labelledby'?: string;
  id?: string;
  class?: string;
}

// Typage explicite : le renommage `as: Balise` empêche l'inférence
// automatique d'Astro de rattacher `Astro.props` à l'interface `Props`.
const {
  fond = 'paper',
  as: Balise = 'section',
  class: classeSupplementaire = '',
  ...reste
}: Props = Astro.props;

const fonds = {
  paper: 'bg-paper',
  warm: 'bg-paper-warm',
  navy: 'bg-navy-900',
} as const;
---

<Balise class:list={[fonds[fond], classeSupplementaire]} {...reste}>
  <div class="mx-auto max-w-page px-gutter py-section lg:px-10 lg:py-section-lg">
    <slot />
  </div>
</Balise>
