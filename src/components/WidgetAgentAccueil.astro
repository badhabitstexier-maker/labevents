---
/**
 * Widget de chat de l'agent d'accueil (n8n, `@n8n/chat`).
 *
 * L'URL du webhook n'est jamais versionnée : ce dépôt est public. Elle provient
 * exclusivement de `PUBLIC_N8N_CHAT_URL`, configurée dans l'environnement
 * d'hébergement avant le build. Sans elle, le composant ne rend rien — même
 * doctrine que les coordonnées absentes de `contact.ts`.
 *
 * La bibliothèque est épinglée à une version exacte sur le CDN : sans numéro,
 * jsDelivr sert la dernière publiée, et le site changerait sans PR.
 *
 * Le bundle pèse ~437 Ko compressés (1,7 Mo bruts) : il est chargé après
 * l'événement `load`, pendant un temps mort du navigateur, pour ne pas peser
 * sur l'affichage de la page.
 *
 * Les libellés par défaut de la bibliothèque sont remplacés en totalité : ils
 * sont en anglais, promettent une présence « 24/7 » et présentent un
 * interlocuteur nommé « Nathan » — trois affirmations fausses pour LabEvents.
 * Le message d'ouverture est repris mot pour mot de
 * `agent-accueil/PROMPT-SYSTEME.md` (§ Ouverture).
 */
const chatUrl = import.meta.env.PUBLIC_N8N_CHAT_URL ?? '';
const version = '1.37.2';
const cdn = `https://cdn.jsdelivr.net/npm/@n8n/chat@${version}/dist`;
---

{
  chatUrl && (
    <>
      <link rel="stylesheet" href={`${cdn}/style.css`} />
      <style is:global>
        :root {
          --chat--font-family: var(--font-sans);
          --chat--color--primary: var(--color-navy-900);
          --chat--color--primary-shade-50: var(--color-navy-900);
          --chat--color--primary--shade-100: var(--color-navy-900);
          --chat--color--secondary: var(--color-navy-900);
          --chat--color-secondary-shade-50: var(--color-navy-900);
          --chat--header--background: var(--color-navy-900);
          --chat--header--color: var(--color-ink-inverse);
          --chat--toggle--background: var(--color-navy-900);
          --chat--toggle--hover--background: var(--color-navy-900);
          --chat--toggle--active--background: var(--color-navy-900);
          --chat--toggle--color: var(--color-ink-inverse);
          --chat--message--bot--background: var(--color-paper-warm);
          --chat--message--bot--color: var(--color-ink);
          --chat--message--user--background: var(--color-navy-900);
          --chat--message--user--color: var(--color-ink-inverse);
        }

        /*
         * Bulle d'accroche du lanceur. @n8n/chat 1.37.2 ne prévoit aucun
         * libellé sur le bouton fermé (i18n : title, subtitle, footer,
         * getStarted, inputPlaceholder, closeButtonTooltip) : elle est donc
         * posée à côté, alignée sur le lanceur de 64 px, masquée tant que la
         * fenêtre est ouverte.
         */
        .accroche-agent {
          position: fixed;
          z-index: 9999;
          bottom: calc(var(--chat--window--bottom, 1rem) + 32px);
          right: calc(var(--chat--window--right, 1rem) + 64px + 0.75rem);
          transform: translateY(50%);
          padding: 0.5rem 1rem;
          border: 1px solid var(--color-line);
          border-radius: var(--radius-full);
          background: var(--color-paper);
          box-shadow: var(--shadow-subtle);
          color: var(--color-ink-strong);
          font-family: var(--font-sans);
          font-size: var(--text-xs);
          line-height: 1.3;
          white-space: nowrap;
          cursor: pointer;
        }
      </style>
      <button type="button" class="accroche-agent" hidden>Besoin d'un renseignement ?</button>
      <script is:inline define:vars={{ chatUrl, cdn }}>
        const demarrer = () =>
          import(`${cdn}/chat.bundle.es.js`).then(({ createChat }) => {
            createChat({
              webhookUrl: chatUrl,
              mode: 'window',
              showWelcomeScreen: false,
              loadPreviousSession: true,
              defaultLanguage: 'en',
              initialMessages: [
                "Bonjour, je suis l'assistant LabEvents. Je peux vous aider à préciser votre demande avant une prise de contact avec Philippe. Vous venez pour le Salon de l'Emploi & de la Formation, pour un projet événementiel, pour un site internet, pour une automatisation, ou pour autre chose ?",
              ],
              i18n: {
                en: {
                  title: 'LabEvents',
                  subtitle: 'Une question ? On vous répond',
                  footer: '',
                  getStarted: 'Nouvelle conversation',
                  inputPlaceholder: 'Écrivez votre message…',
                  closeButtonTooltip: 'Fermer',
                },
              },
            });
            relierAccroche();
          });

        // La fenêtre du widget passe de `display: none` à visible à l'ouverture :
        // l'accroche suit cet état et n'apparaît qu'une fois le lanceur rendu.
        const relierAccroche = () => {
          const accroche = document.querySelector('.accroche-agent');
          const fenetre = document.querySelector('.chat-window-wrapper .chat-window');
          const lanceur = document.querySelector('.chat-window-wrapper .chat-window-toggle');
          if (!accroche || !fenetre || !lanceur) return;

          const synchroniser = () => {
            accroche.hidden = fenetre.style.display !== 'none';
          };
          new MutationObserver(synchroniser).observe(fenetre, {
            attributes: true,
            attributeFilter: ['style'],
          });
          accroche.addEventListener('click', () => lanceur.click());
          synchroniser();
        };

        const planifier = () =>
          'requestIdleCallback' in window
            ? requestIdleCallback(demarrer, { timeout: 4000 })
            : setTimeout(demarrer, 1500);

        if (document.readyState === 'complete') planifier();
        else window.addEventListener('load', planifier, { once: true });
      </script>
    </>
  )
}
