---
/** Page Événementiel — refonte visuelle du Lot 5A.1 + vidéos de réalisations. */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Bouton from '@components/Bouton.astro';
import {
  etapesEvenementielles,
  pageEvenementiel,
  realisationsEvenementielles,
} from '@data/evenementiel';
import { seoEvenementiel } from '@data/seo';

const photosHero = [
  realisationsEvenementielles[0]!,
  realisationsEvenementielles[4]!,
  realisationsEvenementielles[1]!,
];

const dimensions: Record<string, [number, number]> = {
  acdet: [2048, 1536],
  'forum-emploi': [1536, 2048],
  'forum-immobilier': [2048, 1536],
  'job-dating': [2048, 1536],
  'reseaux-eau': [1536, 2048],
  'salon-electricite': [2048, 1536],
  'trophees-entreprises': [2048, 1367],
  'trophees-initiatives-publiques': [1954, 1520],
};

function imageOptimisee(image: string) {
  const nom = image.split('/').at(-1)?.replace(/\.(jpe?g|png)$/i, '') ?? '';
  const [width, height] = dimensions[nom] ?? [1280, 960];
  return {
    src: `/images/optimized/evenementiel/${nom}-1280.webp`,
    srcset: `/images/optimized/evenementiel/${nom}-640.webp 640w, /images/optimized/evenementiel/${nom}-1280.webp 1280w`,
    width,
    height,
  };
}

const videosParRealisation: Record<string, { src: string; titre: string }> = {
  'forum-emploi': {
    src: '/videos/salon-emploi-2023.mp4',
    titre: 'Forum de l’Emploi et de la Formation — rétrospective 2023',
  },
  acdet: {
    src: '/videos/acdet-decouverte-metiers-formations.mp4',
    titre: 'Salon ACDET — Découverte des métiers et des formations',
  },
  'reseaux-eau': {
    src: '/videos/reseau-pro-2023.mp4',
    titre: 'Salon Réseau Pro 2023',
  },
};
---

<BaseLayout titreComplet={seoEvenementiel.titre} description={seoEvenementiel.description}>
  <Section rythme="compact" aria-labelledby="titre-evenementiel" class="overflow-hidden [&>div]:py-10 sm:[&>div]:py-12 md:[&>div]:py-9 lg:[&>div]:py-14">
    <div class="grid gap-10 md:gap-7 lg:grid-cols-12 lg:items-center lg:gap-12 xl:gap-16">
      <div class="relative lg:col-span-5 lg:py-8">
        <div class="border-l border-gold-500 pl-7 sm:pl-9">
          <p class="text-2xs font-semibold tracking-widest text-gold-600 uppercase">{pageEvenementiel.hero.surtitre}</p>
          <h1 id="titre-evenementiel" class="mt-5 max-w-texte text-3xl font-medium">{pageEvenementiel.hero.titre}</h1>
          <p class="mt-6 max-w-texte text-sm text-ink-muted">{pageEvenementiel.hero.texte}</p>
          <div class="mt-7"><Bouton href="/contact">{pageEvenementiel.hero.cta}<span aria-hidden="true">→</span></Bouton></div>
        </div>
      </div>

      <div class="grid h-96 grid-cols-5 grid-rows-2 gap-3 sm:h-112 md:h-104 lg:col-span-7 lg:h-120">
        {photosHero.map((photo, index) => {
          const source = imageOptimisee(photo.image);
          return (
            <img
              src={source.src}
              srcset={source.srcset}
              sizes="(min-width: 1024px) 40vw, 50vw"
              width={source.width}
              height={source.height}
              alt={photo.alt}
              decoding="async"
              fetchpriority={index === 0 ? 'high' : 'auto'}
              class:list={['h-full w-full rounded-md object-cover', index === 0 ? 'col-span-3 row-span-2' : 'col-span-2']}
            />
          );
        })}
      </div>
    </div>
  </Section>

  <Section fond="warm" rythme="compact" aria-labelledby="titre-positionnement-evenementiel" class="[&>div]:py-10 lg:[&>div]:py-14">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <img
        src="/images/optimized/evenementiel/trophees-entreprises-1280.webp"
        srcset="/images/optimized/evenementiel/trophees-entreprises-640.webp 640w, /images/optimized/evenementiel/trophees-entreprises-1280.webp 1280w"
        sizes="(min-width: 1024px) 40vw, 100vw"
        width="2048"
        height="1367"
        alt="Trophée présenté lors des Trophées des Entreprises"
        loading="lazy"
        decoding="async"
        class="aspect-panneau w-full rounded-md object-cover lg:col-span-5"
      />
      <div class="lg:col-span-7">
        <h2 id="titre-positionnement-evenementiel" class="text-xl font-medium">{pageEvenementiel.positionnement.titre}</h2>
        <span class="mt-4 block h-px w-10 bg-gold-500" aria-hidden="true"></span>
        <div class="mt-6 space-y-3">{pageEvenementiel.positionnement.paragraphes.map((paragraphe) => (<p class="max-w-texte text-xs text-ink-muted">{paragraphe}</p>))}</div>
        <ol class="mt-9 grid gap-6 sm:grid-cols-3 sm:gap-0">
          {etapesEvenementielles.map((etape, index) => (
            <li class:list={['flex items-center gap-4 sm:block sm:px-6', index > 0 && 'sm:border-l sm:border-line', index === 0 && 'sm:pl-0']}>
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-gold-500 text-2xs font-medium text-gold-600" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p class="text-xs font-medium text-ink-strong sm:mt-4">{etape}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Section>

  <Section rythme="compact" aria-labelledby="titre-publics-evenementiel" class="[&>div]:pt-10 [&>div]:pb-6 lg:[&>div]:pt-14 lg:[&>div]:pb-8">
    <h2 id="titre-publics-evenementiel" class="sr-only">Événements BtoB et BtoC</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {pageEvenementiel.publics.map((publicCible, index) => (
        <article class="relative rounded-md border border-line bg-paper px-7 py-8 sm:px-9">
          <span class="block h-px w-8 bg-gold-500" aria-hidden="true"></span>
          <h3 class="mt-5 pr-16 text-lg font-medium">{publicCible.titre}</h3>
          <p class="mt-4 max-w-texte pr-0 text-xs text-ink-muted sm:pr-16">{publicCible.texte}</p>
          <span class="absolute top-8 right-7 flex size-12 items-center justify-center rounded-full bg-paper-warm text-gold-600 sm:top-1/2 sm:right-9 sm:-translate-y-1/2" aria-hidden="true">
            {index === 0 ? (
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M4 7h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><path d="M3 12h18M10 12v2h4v-2"/></svg>
            ) : (
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20v-2a5 5 0 0 1 10 0v2M14 14.5a4 4 0 0 1 7 2.5v2"/></svg>
            )}
          </span>
        </article>
      ))}
    </div>
  </Section>

  <Section rythme="compact" aria-labelledby="titre-realisations-evenementielles" class="[&>div]:pt-6 [&>div]:pb-6 lg:[&>div]:pt-8 lg:[&>div]:pb-8">
    <p class="text-2xs font-semibold tracking-widest text-gold-600 uppercase">{pageEvenementiel.realisations.surtitre}</p>
    <h2 id="titre-realisations-evenementielles" class="mt-4 max-w-content text-lg font-medium">{pageEvenementiel.realisations.titre}</h2>
    <span class="mt-5 block h-px w-10 bg-gold-500" aria-hidden="true"></span>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {realisationsEvenementielles.map((realisation) => {
        const source = imageOptimisee(realisation.image);
        const video = videosParRealisation[realisation.id];
        return (
          <article class="overflow-hidden rounded-md border border-line bg-paper">
            {video ? (
              <button
                type="button"
                class:list={[
                  'group relative block aspect-panneau w-full overflow-hidden text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900',
                  realisation.modeAffichage === 'contain' && 'bg-paper-warm p-4',
                ]}
                data-video-open
                data-video-src={video.src}
                data-video-title={video.titre}
                data-video-poster={source.src}
                aria-label={`Voir la vidéo : ${video.titre}`}
              >
                <img
                  src={source.src}
                  srcset={source.srcset}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 100vw"
                  width={source.width}
                  height={source.height}
                  alt={realisation.alt}
                  loading="lazy"
                  decoding="async"
                  class:list={['h-full w-full transition-transform duration-300 group-hover:scale-[1.02]', realisation.modeAffichage === 'contain' ? 'object-contain' : 'object-cover']}
                />
                <span class="absolute inset-0 bg-navy-900/20 transition-colors duration-200 group-hover:bg-navy-900/45" aria-hidden="true"></span>
                <span class="absolute inset-x-0 bottom-0 flex items-center justify-center gap-2 px-4 py-4 text-xs font-semibold text-white sm:opacity-0 sm:transition-opacity sm:duration-200 sm:group-hover:opacity-100 sm:group-focus-visible:opacity-100">
                  <span class="flex size-9 items-center justify-center rounded-full bg-white/95 text-navy-900 shadow-subtle">
                    <svg viewBox="0 0 24 24" class="ml-0.5 size-4" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5-10-6.5Z"/></svg>
                  </span>
                  <span class="rounded-full bg-navy-900/75 px-3 py-2">Voir la vidéo</span>
                </span>
              </button>
            ) : (
              <div class:list={['aspect-panneau overflow-hidden', realisation.modeAffichage === 'contain' && 'bg-paper-warm p-4']}>
                <img
                  src={source.src}
                  srcset={source.srcset}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 100vw"
                  width={source.width}
                  height={source.height}
                  alt={realisation.alt}
                  loading="lazy"
                  decoding="async"
                  class:list={['h-full w-full', realisation.modeAffichage === 'contain' ? 'object-contain' : 'object-cover']}
                />
              </div>
            )}
            <div class="px-5 py-5"><h3 class="text-sm font-medium leading-snug">{realisation.titre}</h3></div>
          </article>
        );
      })}
    </div>
  </Section>

  <Section rythme="compact" aria-labelledby="titre-contact-evenementiel" class="[&>div]:pt-6 [&>div]:pb-0 lg:[&>div]:pt-8 lg:[&>div]:pb-0">
    <div class="relative overflow-hidden rounded-md bg-navy-900 px-7 py-9 sm:px-10 lg:px-14 lg:py-10">
      <div class="grid gap-8 border-l border-gold-500 pl-7 lg:grid-cols-12 lg:items-center lg:gap-12 lg:pl-10">
        <div class="lg:col-span-7">
          <h2 id="titre-contact-evenementiel" class="text-xl font-medium text-ink-inverse">{pageEvenementiel.contact.titre}</h2>
          <p class="mt-3 max-w-texte text-xs text-ink-inverse-muted">{pageEvenementiel.contact.texte}</p>
        </div>
        <div class="lg:col-span-5 lg:text-right"><Bouton href="/contact" variante="inverse">{pageEvenementiel.contact.cta}<span aria-hidden="true">→</span></Bouton></div>
      </div>
    </div>
  </Section>

  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-navy-950/90 p-4 sm:p-8"
    data-video-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="video-modal-title"
    hidden
  >
    <div class="relative w-full max-w-5xl overflow-hidden rounded-md bg-navy-900 shadow-media" data-video-panel>
      <div class="flex items-center justify-between gap-4 border-b border-white/15 px-4 py-3 sm:px-5">
        <h2 id="video-modal-title" class="text-sm font-medium text-white" data-video-title></h2>
        <button
          type="button"
          class="flex size-11 shrink-0 items-center justify-center rounded-full border border-white/30 text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          data-video-close
          aria-label="Fermer la vidéo"
        >
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div class="bg-black">
        <video class="mx-auto max-h-[78vh] w-full bg-black" controls playsinline preload="none" data-video-player>
          <source data-video-source type="video/mp4" />
          Votre navigateur ne prend pas en charge la lecture de cette vidéo.
        </video>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const modal = document.querySelector('[data-video-modal]');
      const panel = document.querySelector('[data-video-panel]');
      const player = document.querySelector('[data-video-player]');
      const source = document.querySelector('[data-video-source]');
      const title = document.querySelector('[data-video-title]');
      const closeButton = document.querySelector('[data-video-close]');
      const openButtons = document.querySelectorAll('[data-video-open]');

      if (!(modal instanceof HTMLElement) || !(panel instanceof HTMLElement) || !(player instanceof HTMLVideoElement) || !(source instanceof HTMLSourceElement) || !(title instanceof HTMLElement) || !(closeButton instanceof HTMLButtonElement)) return;

      let lastTrigger = null;

      const closeModal = () => {
        player.pause();
        player.removeAttribute('poster');
        source.removeAttribute('src');
        player.load();
        modal.hidden = true;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.documentElement.style.overflow = '';
        if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
        lastTrigger = null;
      };

      const openModal = (trigger) => {
        if (!(trigger instanceof HTMLElement)) return;
        const src = trigger.dataset.videoSrc;
        const videoTitle = trigger.dataset.videoTitle;
        const poster = trigger.dataset.videoPoster;
        if (!src || !videoTitle) return;

        lastTrigger = trigger;
        source.src = src;
        title.textContent = videoTitle;
        if (poster) player.poster = poster;
        player.load();
        modal.hidden = false;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.documentElement.style.overflow = 'hidden';
        closeButton.focus();
      };

      openButtons.forEach((button) => button.addEventListener('click', () => openModal(button)));
      closeButton.addEventListener('click', closeModal);
      modal.addEventListener('click', (event) => {
        if (event.target === modal) closeModal();
      });
      panel.addEventListener('click', (event) => event.stopPropagation());
      document.addEventListener('keydown', (event) => {
        if (!modal.hidden && event.key === 'Escape') {
          event.preventDefault();
          closeModal();
        }
      });
    })();
  </script>
</BaseLayout>
