---
/**
 * ACCUEIL — labevents.nc (Lot 1).
 *
 * Rôle de la page (CLAUDE.md § B) : faire comprendre immédiatement les deux
 * activités, orienter, afficher très tôt des preuves réelles, puis faciliter
 * la prise de contact.
 *
 * Ordre de la page, arrêté :
 *   1. en-tête (layout) ;
 *   2. hero ;
 *   3. les deux expertises ;
 *   4. introduction des réalisations ;
 *   5. salonemploi.nc ;
 *   6. écosystème nounou.nc ;
 *   7. LabEvents en Nouvelle-Calédonie ;
 *   8. contact ;
 *   9. pied de page (layout).
 *
 * ⚠️ Tous les textes viennent de `src/data/`. Aucun fait, aucun chiffre,
 * aucun témoignage, aucune photo, aucune capture n'est inventé ici. Les
 * les coordonnées affichées viennent exclusivement de `src/data/contact.ts`.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Bouton from '@components/Bouton.astro';
import PorteActivite from '@components/PorteActivite.astro';
import MiseEnAvantRealisation from '@components/MiseEnAvantRealisation.astro';
import EcosystemeNounou from '@components/EcosystemeNounou.astro';
import BarreReassurance from '@components/BarreReassurance.astro';
import { activites, type ActiviteId } from '@data/site';
import { ctaPrincipal, ctaSecondaire } from '@data/navigation';
import { accueil, sectionsAccueil } from '@data/messages';
import { realisationParId } from '@data/realisations';
import { seoAccueil } from '@data/seo';

/** Descriptions des deux portes — reprises telles quelles de `messages.ts`. */
const descriptions: Record<ActiviteId, string> = {
  evenementiel: sectionsAccueil.expertises.evenementiel,
  'sites-internet': sectionsAccueil.expertises.sitesInternet,
};

/** Pictogramme de repérage du panneau neutre de chaque porte. */
const pictos: Record<ActiviteId, 'evenementiel' | 'web'> = {
  evenementiel: 'evenementiel',
  'sites-internet': 'web',
};

const salonEmploi = realisationParId('salonemploi-nc');
---

<BaseLayout
  titreComplet={seoAccueil.titre}
  description={seoAccueil.description}
>
  {/* --- 2. Hero -------------------------------------------------------- */}
  <Section aria-labelledby="titre-hero">
    <div class="max-w-content">
      <h1 id="titre-hero" class="text-4xl">{accueil.titre}</h1>

      <p class="mt-8 max-w-texte text-base text-ink-muted lg:text-lg">
        {accueil.sousTitre}
      </p>

      <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <Bouton href={ctaPrincipal.href}>{ctaPrincipal.label}</Bouton>
        <Bouton href={ctaSecondaire.href} variante="secondaire">
          {ctaSecondaire.label}
        </Bouton>
      </div>
    </div>
  </Section>

  {/* --- 3. Les deux expertises ----------------------------------------- */}
  <Section fond="warm" aria-labelledby="titre-expertises">
    <h2 id="titre-expertises" class="text-2xl">
      {sectionsAccueil.expertises.titre}
    </h2>

    <div class="mt-bloc grid gap-bloc md:grid-cols-2 md:gap-10 lg:mt-16 lg:gap-16">
      {
        activites.map((activite) => (
          <PorteActivite
            label={activite.label}
            href={activite.href}
            porte={activite.porte}
            description={descriptions[activite.id]}
            picto={pictos[activite.id]}
          />
        ))
      }
    </div>
  </Section>

  {/* --- 4 à 6. Réalisations -------------------------------------------- */}
  <Section aria-labelledby="titre-realisations">
    <h2 id="titre-realisations" class="max-w-content text-2xl">
      {sectionsAccueil.realisations.titre}
    </h2>
    <p class="mt-6 max-w-texte text-base text-ink-muted">
      {sectionsAccueil.realisations.chapo}
    </p>

    <div class="mt-section space-y-section lg:mt-24 lg:space-y-24">
      {
        /* 5. salonemploi.nc — mention factuelle uniquement. Aucune
           fonctionnalité n'est décrite : rien n'a été vérifié sur le site
           réellement en ligne (CLAUDE.md § F). */
        salonEmploi && (
          <MiseEnAvantRealisation
            realisation={salonEmploi}
            surTitre="Réalisation digitale"
          />
        )
      }

      {/* 6. Écosystème nounou.nc */}
      <div class="border-t border-line pt-section lg:pt-24">
        <EcosystemeNounou />
      </div>
    </div>
  </Section>

  {/* --- 7. LabEvents en Nouvelle-Calédonie ------------------------------ */}
  <Section fond="navy" aria-labelledby="titre-territoire">
    <div class="max-w-content">
      <h2 id="titre-territoire" class="text-2xl text-ink-inverse">
        {sectionsAccueil.territoire.titre}
      </h2>
      <p class="mt-6 max-w-texte text-base text-ink-inverse-muted">
        {sectionsAccueil.territoire.texte}
      </p>
    </div>
  </Section>

  {/* --- 8. Contact ------------------------------------------------------ */}
  <Section aria-labelledby="titre-contact">
    <div class="max-w-content">
      <h2 id="titre-contact" class="text-2xl">{sectionsAccueil.contact.titre}</h2>
      <p class="mt-6 max-w-texte text-base text-ink-muted">
        {sectionsAccueil.contact.texte}
      </p>

      <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <Bouton href={ctaPrincipal.href}>{ctaPrincipal.label}</Bouton>
      </div>

      {/* Le bloc téléphone n'est rendu que parce qu'un vrai numéro validé
          existe dans `src/data/contact.ts`. Aucune valeur de remplissage. */}
      <BarreReassurance class="mt-bloc max-w-texte" />
    </div>
  </Section>
</BaseLayout>
