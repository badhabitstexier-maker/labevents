---
/** Accueil — refonte visuelle et intégration des preuves réelles (Lot 5B). */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Bouton from '@components/Bouton.astro';
import BarreReassurance from '@components/BarreReassurance.astro';
import {
  ctaAccueilEvenementiel,
  ctaAccueilSitesInternet,
  ctaPrincipal,
} from '@data/navigation';
import { accueil, sectionsAccueil, etudeDeCas } from '@data/messages';
import { ecosystemeNounou, realisationParId } from '@data/realisations';
import { seoAccueil } from '@data/seo';

const salonEmploi = realisationParId('salonemploi-nc');

const sitesNounou = [
  { ...ecosystemeNounou.sites[0], capture: '/images/web/nounou-home.png' },
  { ...ecosystemeNounou.sites[1], capture: '/images/web/nounou-devoirs.png' },
  { ...ecosystemeNounou.sites[2], capture: '/images/web/nounou-pet.png' },
  { ...ecosystemeNounou.sites[3], capture: '/images/web/nounou-gardiennage.png' },
  { ...ecosystemeNounou.sites[4], capture: '/images/web/nounou-services.png' },
] as const;
---

<BaseLayout titreComplet={seoAccueil.titre} description={seoAccueil.description}>
  <div class="hidden border-b border-line bg-paper md:block">
    <div class="mx-auto max-w-page px-gutter py-3 lg:px-10">
      <BarreReassurance />
    </div>
  </div>

  <Section
    rythme="compact"
    aria-labelledby="titre-hero"
    class="[&>div]:py-6 sm:[&>div]:py-8 lg:[&>div]:py-10"
  >
    <div class="overflow-hidden rounded-md border border-line bg-paper lg:grid lg:min-h-112 lg:grid-cols-12">
      <div class="flex flex-col justify-center px-6 py-9 sm:px-10 sm:py-12 lg:col-span-5 lg:px-12 xl:px-14">
        <h1 id="titre-hero" class="text-2xl font-medium">{accueil.titre}</h1>
        <p class="mt-6 max-w-texte text-sm text-ink-muted">{accueil.sousTitre}</p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          <Bouton href={ctaAccueilEvenementiel.href} class="w-full">
            {ctaAccueilEvenementiel.label}
          </Bouton>
          <Bouton href={ctaAccueilSitesInternet.href} class="w-full">
            {ctaAccueilSitesInternet.label}
          </Bouton>
        </div>
      </div>
      <img
        src="/images/accueil/accueil-evenementiel.jpg"
        alt="Vue d’ensemble d’un salon professionnel organisé en Nouvelle-Calédonie"
        width="1672"
        height="941"
        fetchpriority="high"
        decoding="async"
        class="h-72 w-full object-cover sm:h-96 lg:col-span-7 lg:h-full"
      />
    </div>
  </Section>

  <Section
    rythme="compact"
    aria-labelledby="titre-expertises"
    class="[&>div]:pt-5 [&>div]:pb-10 lg:[&>div]:pt-6 lg:[&>div]:pb-14"
  >
    <h2 id="titre-expertises" class="sr-only">Nos services et une réalisation mise en avant</h2>
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-5">
      <div class="lg:col-span-5">
        <p class="mb-4 text-2xs font-semibold tracking-widest text-ink-strong uppercase">Nos services</p>
        <div class="grid gap-5 sm:grid-cols-2">
          <a href="/evenementiel" class="group overflow-hidden rounded-md border border-line bg-paper transition-colors hover:border-line-strong">
            <img
              src="/images/evenementiel/job-dating.jpg"
              alt="Participants échangeant lors d’un job dating organisé par LabEvents"
              width="2048"
              height="1536"
              loading="lazy"
              decoding="async"
              class="aspect-panneau w-full object-cover"
            />
            <div class="px-5 py-5">
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-xs font-semibold tracking-wide uppercase">Événementiel</h3>
                <span class="text-lg text-gold-500 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </div>
              <p class="mt-3 text-xs text-ink-muted">{sectionsAccueil.expertises.cartes.evenementiel}</p>
            </div>
          </a>

          <a href="/sites-internet" class="group overflow-hidden rounded-md border border-line bg-paper transition-colors hover:border-line-strong">
            <div class="relative aspect-panneau overflow-hidden bg-paper-warm p-4">
              <div class="flex h-full flex-col overflow-hidden rounded-sm border border-line-strong bg-paper shadow-subtle">
                <span class="block h-3 shrink-0 border-b border-line bg-paper-cool"></span>
                <img
                  src="/images/web/nounou-home.png"
                  alt="Capture de la page d’accueil de nounou.nc"
                  width="2742"
                  height="1662"
                  loading="lazy"
                  decoding="async"
                  class="min-h-0 w-full flex-1 object-cover object-top"
                />
              </div>
            </div>
            <div class="px-5 py-5">
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-xs font-semibold tracking-wide uppercase">Sites internet</h3>
                <span class="text-lg text-gold-500 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </div>
              <p class="mt-3 text-xs text-ink-muted">{sectionsAccueil.expertises.cartes.sitesInternet}</p>
            </div>
          </a>
        </div>
      </div>

      {salonEmploi && (
        <article class="lg:col-span-7">
          <p class="mb-4 text-2xs font-semibold tracking-widest text-ink-strong uppercase">Réalisation digitale</p>
          <div class="grid h-full overflow-hidden rounded-md border border-line bg-paper lg:grid-cols-12">
            <div class="px-6 py-8 sm:px-8 lg:col-span-6 lg:flex lg:flex-col lg:justify-center">
              <h3 class="text-lg whitespace-nowrap">{salonEmploi.titre}</h3>
              <p class="mt-5 text-xs text-ink-muted">{salonEmploi.nature}</p>
              {salonEmploi.url && (
                <a
                  href={salonEmploi.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-7 inline-flex min-h-11 items-center gap-2 self-start text-xs font-medium text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4"
                >
                  {etudeDeCas.lien}<span aria-hidden="true">↗</span>
                  <span class="sr-only">— {salonEmploi.titre}, nouvelle fenêtre</span>
                </a>
              )}
            </div>
            <div class="relative min-h-80 overflow-hidden bg-paper-warm p-6 sm:min-h-96 lg:col-span-6">
              <div class="absolute top-12 right-7 left-7 overflow-hidden rounded-sm border border-line-strong bg-paper shadow-media">
                <span class="block h-3 border-b border-line bg-paper-cool"></span>
                <img src="/images/web/salonemploi-desktop.png" alt="Capture de la page d’accueil du site salonemploi.nc sur ordinateur" width="2736" height="1590" loading="lazy" decoding="async" />
              </div>
              <div class="absolute right-7 bottom-5 h-40 w-20 overflow-hidden rounded-lg border border-navy-900 bg-paper shadow-media sm:h-48 sm:w-24">
                <img src="/images/web/salonemploi-mobile.png" alt="Capture de la page d’accueil du site salonemploi.nc sur mobile" width="390" height="6097" loading="lazy" decoding="async" class="h-full w-full object-cover object-[center_35%]" />
              </div>
            </div>
          </div>
        </article>
      )}
    </div>
  </Section>

  <Section fond="warm" rythme="compact" aria-labelledby="titre-ecosysteme" class="[&>div]:py-12 lg:[&>div]:py-16">
    <div class="rounded-md border border-line bg-paper px-5 py-7 sm:px-8 sm:py-9">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-2xs font-semibold tracking-widest text-gold-600 uppercase">Réalisation digitale</p>
          <h2 id="titre-ecosysteme" class="mt-3 text-xl">nounou.nc — l’écosystème</h2>
        </div>
        <p class="text-xs text-ink-muted">{ecosystemeNounou.formulation}</p>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {sitesNounou.map((site) => (
          <li>
            <a href={site.url} target="_blank" rel="noopener noreferrer" class="group block">
              <div class="overflow-hidden rounded-sm border border-line-strong bg-paper shadow-subtle">
                <span class="flex h-4 items-center gap-1 border-b border-line bg-paper-cool px-2" aria-hidden="true">
                  <span class="size-1 rounded-full bg-line-strong"></span><span class="size-1 rounded-full bg-line-strong"></span><span class="size-1 rounded-full bg-line-strong"></span>
                </span>
                <img src={site.capture} alt={`Capture de la page d’accueil de ${site.label}`} width="2744" height="1662" loading="lazy" decoding="async" class="aspect-panneau-large w-full object-cover object-top" />
              </div>
              <span class="mt-3 block text-2xs font-medium break-words text-ink-strong underline decoration-line underline-offset-4 transition-colors group-hover:decoration-gold-500">
                {site.label}<span class="sr-only"> — nouvelle fenêtre</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section rythme="compact" aria-labelledby="titre-territoire" class="[&>div]:py-12 lg:[&>div]:py-16">
    <div class="grid gap-8 border-t border-line pt-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <h2 id="titre-territoire" class="text-xl">{sectionsAccueil.territoire.titre}</h2>
        <p class="mt-4 max-w-texte text-xs text-ink-muted">{sectionsAccueil.territoire.texte}</p>
      </div>
      <div class="lg:col-span-5 lg:text-right">
        <h2 class="text-xl">{sectionsAccueil.contact.titre}</h2>
        <p class="mt-3 text-xs text-ink-muted">{sectionsAccueil.contact.texte}</p>
        <div class="mt-6"><Bouton href={ctaPrincipal.href}>{ctaPrincipal.label}<span aria-hidden="true">→</span></Bouton></div>
      </div>
    </div>
  </Section>
</BaseLayout>
