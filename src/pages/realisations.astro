---
/**
 * RÉALISATIONS — page centrale de preuve V1, refonte visuelle Lot 5D.
 *
 * La composition suit la référence du lot avec uniquement les textes et les
 * visuels validés. `publiable` et `capturesValidees` restent des garde-fous
 * distincts : les captures peuvent être montrées sans publier une étude de
 * cas encore non vérifiée.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Bouton from '@components/Bouton.astro';
import EcosystemeNounou from '@components/EcosystemeNounou.astro';
import IconeRealisation, {
  type NomIconeRealisation,
} from '@components/IconeRealisation.astro';
import MiseEnAvantRealisation from '@components/MiseEnAvantRealisation.astro';
import MotifCourbes from '@components/MotifCourbes.astro';
import { pageRealisations } from '@data/messages';
import { ctaPrincipal, ctaSecondaire } from '@data/navigation';
import { realisationParId } from '@data/realisations';
import { seoRealisations } from '@data/seo';

const salonEmploi = realisationParId('salonemploi-nc');
const iconesPrincipes: readonly NomIconeRealisation[] = [
  'cible',
  'ecran',
  'localisation',
];

if (!salonEmploi) {
  throw new Error('La réalisation salonemploi.nc est absente de la source de données.');
}
---

<BaseLayout
  titreComplet={seoRealisations.titre}
  description={seoRealisations.description}
>
  <Section
    rythme="compact"
    aria-labelledby="titre-realisations"
    class="[&>div]:py-16 lg:[&>div]:py-24"
  >
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-7">
        <p class="text-2xs font-semibold tracking-widest text-gold-600 uppercase">
          {pageRealisations.surtitre}
        </p>
        <h1 id="titre-realisations" class="mt-5 max-w-texte text-3xl">
          {pageRealisations.titre}
        </h1>
      </div>
      <div class="border-l border-gold-500 py-1 pl-6 lg:col-span-5 lg:pl-10">
        <p class="max-w-texte text-sm text-ink-muted">
          {pageRealisations.introduction}
        </p>
      </div>
    </div>
  </Section>

  <Section
    rythme="compact"
    fond="warm"
    aria-labelledby="titre-projets-reels"
    class="relative overflow-hidden [&>div]:py-12 lg:[&>div]:py-14"
  >
    <MotifCourbes class="absolute top-0 right-0 h-full w-auto opacity-20" />
    <div class="relative max-w-content">
      <span class="block h-px w-8 bg-gold-500" aria-hidden="true"></span>
      <h2 id="titre-projets-reels" class="mt-5 max-w-texte text-xl">
        {pageRealisations.projets.titre}
      </h2>
    </div>
  </Section>

  <Section
    rythme="compact"
    aria-labelledby="titre-salonemploi"
    class="[&>div]:py-16 lg:[&>div]:py-20"
  >
    <MiseEnAvantRealisation
      realisation={salonEmploi}
      surTitre="Réalisation digitale"
      niveauTitre="h2"
      idTitre="titre-salonemploi"
    />
  </Section>

  <Section
    rythme="compact"
    aria-labelledby="titre-nounou"
    class="border-t border-line [&>div]:py-16 lg:[&>div]:py-20"
  >
    <EcosystemeNounou niveauTitre="h2" idTitre="titre-nounou" />
  </Section>

  <Section
    fond="warm"
    rythme="compact"
    aria-labelledby="titre-principes-realisations"
    class="relative overflow-hidden [&>div]:py-16 lg:[&>div]:py-20"
  >
    <h2 id="titre-principes-realisations" class="sr-only">
      Les principes des réalisations LabEvents
    </h2>
    <MotifCourbes class="absolute -bottom-10 -left-24 w-64 -scale-x-100 opacity-15" />
    <MotifCourbes class="absolute -top-10 -right-24 w-64 opacity-15" />
    <ul class="relative grid gap-10 md:grid-cols-3 md:gap-0">
      {
        pageRealisations.principes.map((principe, index) => (
          <li class="flex flex-col items-center text-center md:border-l md:border-line md:px-8 first:md:border-l-0">
            <span class="flex size-14 items-center justify-center rounded-full border border-gold-500 text-gold-600">
              <IconeRealisation nom={iconesPrincipes[index] ?? 'cible'} class="size-7" />
            </span>
            <h3 class="mt-5 text-sm">{principe.titre}</h3>
            <p class="mt-3 max-w-texte text-xs text-ink-muted">{principe.texte}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    fond="warm"
    rythme="compact"
    aria-labelledby="titre-contact-realisations"
    class="[&>div]:pt-0 [&>div]:pb-12 lg:[&>div]:pb-16"
  >
    <div class="relative overflow-hidden rounded-md bg-navy-900 px-6 py-10 sm:px-9 lg:px-12 lg:py-11">
      <MotifCourbes class="absolute -right-6 -bottom-16 w-72 text-gold-500 opacity-15" />
      <div class="relative grid gap-9 lg:grid-cols-12 lg:items-center lg:gap-12">
        <div class="border-l-2 border-gold-500 pl-6 lg:col-span-7 lg:pl-8">
          <h2 id="titre-contact-realisations" class="max-w-texte text-xl text-ink-inverse">
            {pageRealisations.contact.titre}
          </h2>
          <p class="mt-4 max-w-texte text-xs text-ink-inverse-muted">
            {pageRealisations.contact.texte}
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1 xl:grid-cols-2">
          <Bouton href={ctaPrincipal.href} variante="inverse" class="w-full">
            {ctaPrincipal.label}
          </Bouton>
          <Bouton
            href={ctaSecondaire.href}
            class="w-full border border-ink-inverse-muted bg-transparent text-ink-inverse hover:border-paper hover:bg-navy-800"
          >
            <IconeRealisation nom="message" class="size-4" />
            {ctaSecondaire.label}
          </Bouton>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
